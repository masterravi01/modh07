---
import { Image } from 'astro:assets';
import aboutImage from '../assets/images/about.jpg';

const cards = [
  {
    title: 'Quality Produce',
    text: 'A focus on fresh fruit and vegetable products, presented with care and a professional standard of service.',
    icon: 'leaf',
  },
  {
    title: 'Reliable Supply',
    text: 'A practical approach to wholesale and retail supply, centred on dependable communication and consistency.',
    icon: 'crate',
  },
  {
    title: 'Professional Service',
    text: 'Straightforward, considered service for customers and business partners discussing fresh produce requirements.',
    icon: 'hands',
  },
] as const;
---

<section id="about" class="bg-paper py-20 sm:py-28" aria-labelledby="about-heading">
  <div class="wrap">
    <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
      <div class="reveal">
        <p class="eyebrow">About</p>
        <h2 id="about-heading" class="display text-3xl sm:text-4xl lg:text-5xl">
          Fresh Produce, Built on Reliability
        </h2>
        <p class="lede mt-6">
          MODH07 LIMITED is an active UK private limited company focused on the
          wholesale and retail supply of fresh fruits and vegetables. We aim to
          provide quality produce and dependable service for customers and
          business partners.
        </p>
      </div>
      <div class="reveal overflow-hidden rounded-3xl">
        <Image
          src={aboutImage}
          alt="Fresh leafy green vegetables arranged as a close-up produce still life"
          widths={[640, 960, 1280]}
          sizes="(min-width: 1024px) 50vw, 100vw"
          class="h-full min-h-[18rem] w-full object-cover"
          loading="lazy"
          quality={75}
        />
      </div>
    </div>

    <ul class="mt-12 grid gap-5 md:grid-cols-3">
      {
        cards.map((card) => (
          <li class="card reveal group p-7 transition duration-200 hover:-translate-y-0.5 hover:border-forest/20">
            <span
              class="mb-5 inline-flex size-11 items-center justify-center rounded-full bg-cream text-leaf"
              aria-hidden="true"
            >
              {card.icon === 'leaf' && (
                <svg class="size-5" viewBox="0 0 24 24" fill="none">
                  <path
                    d="M5 18c7-1.5 11.5-7 13.5-15C9.5 5 4.5 11 5 18Z"
                    stroke="currentColor"
                    stroke-width="1.6"
                  />
                  <path
                    d="M6.5 16.5c3-3 6-6.5 8.5-11"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                  />
                </svg>
              )}
              {card.icon === 'crate' && (
                <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                  <rect x="4" y="7" width="16" height="12" rx="1.5" />
                  <path d="M4 11h16M8 7V5h8v2" stroke-linecap="round" />
                </svg>
              )}
              {card.icon === 'hands' && (
                <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                  <path d="M8 13.5 10.5 8a1.6 1.6 0 0 1 3 .8V11l4.2-.7a1.5 1.5 0 0 1 1.7 1.9L17 18.5H9.5" stroke-linecap="round" stroke-linejoin="round" />
                  <path d="M8 13.5c-1.4.2-3.5 1-3.5 3.2C4.5 18.8 6 20 8 20h1.5" stroke-linecap="round" />
                </svg>
              )}
            </span>
            <h3 class="font-heading text-xl text-forest">{card.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-ink-soft">{card.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
