---
const principles = [
  {
    title: 'Quality',
    text: 'Focused on fresh fruit and vegetable products.',
  },
  {
    title: 'Reliability',
    text: 'A professional approach to serving customers and business requirements.',
  },
  {
    title: 'Simplicity',
    text: 'Straightforward communication and service.',
  },
  {
    title: 'Freshness',
    text: 'A business focused on fresh produce.',
  },
] as const;
---

<section
  id="why"
  class="border-y border-forest/10 bg-cream py-20 sm:py-28"
  aria-labelledby="why-heading"
>
  <div class="wrap">
    <div class="reveal max-w-3xl">
      <p class="eyebrow">Principles</p>
      <h2 id="why-heading" class="display text-3xl sm:text-4xl lg:text-5xl">
        Why MODH07
      </h2>
      <p class="lede mt-6">
        These are the values that guide how we present the business — not
        performance claims or guarantees.
      </p>
    </div>

    <ol class="mt-12 grid gap-px overflow-hidden rounded-3xl border border-forest/10 bg-forest/10 sm:grid-cols-2">
      {
        principles.map((item, index) => (
          <li class="reveal bg-paper p-8 sm:p-10">
            <p class="font-heading text-sm text-citrus">0{index + 1}</p>
            <h3 class="mt-3 font-heading text-2xl text-forest sm:text-3xl">
              {item.title}
            </h3>
            <p class="mt-3 max-w-sm text-base leading-relaxed text-ink-soft">
              {item.text}
            </p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
