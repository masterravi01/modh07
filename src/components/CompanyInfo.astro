---
import { COMPANY } from '../data/site';
---

<section
  id="company"
  class="bg-paper py-20 sm:py-28"
  aria-labelledby="company-heading"
>
  <div class="wrap">
    <div class="reveal max-w-3xl">
      <p class="eyebrow">Registration</p>
      <h2 id="company-heading" class="display text-3xl sm:text-4xl lg:text-5xl">
        Company Information
      </h2>
      <p class="lede mt-6">
        Formal details for MODH07 LIMITED, as a UK private limited company.
      </p>
    </div>

    <div
      class="reveal mt-12 overflow-hidden rounded-3xl border border-forest/10 bg-cream"
    >
      <div class="border-b border-forest/10 bg-forest px-6 py-8 text-cream sm:px-10">
        <p class="text-[0.7rem] font-semibold tracking-[0.22em] text-citrus-soft uppercase">
          Registered in England and Wales
        </p>
        <p class="mt-3 font-heading text-3xl sm:text-4xl">{COMPANY.name}</p>
      </div>

      <dl class="grid gap-px bg-forest/10 sm:grid-cols-2 lg:grid-cols-3">
        <div class="bg-cream px-6 py-6 sm:px-8">
          <dt class="text-xs font-semibold tracking-[0.16em] text-leaf uppercase">
            Company Number
          </dt>
          <dd class="mt-2 font-heading text-2xl text-forest">{COMPANY.number}</dd>
        </div>
        <div class="bg-cream px-6 py-6 sm:px-8">
          <dt class="text-xs font-semibold tracking-[0.16em] text-leaf uppercase">
            Status
          </dt>
          <dd class="mt-2 font-heading text-2xl text-forest">{COMPANY.status}</dd>
        </div>
        <div class="bg-cream px-6 py-6 sm:px-8 sm:col-span-2 lg:col-span-1">
          <dt class="text-xs font-semibold tracking-[0.16em] text-leaf uppercase">
            Company Type
          </dt>
          <dd class="mt-2 font-heading text-2xl text-forest">{COMPANY.type}</dd>
        </div>
        <div class="bg-cream px-6 py-6 sm:px-8">
          <dt class="text-xs font-semibold tracking-[0.16em] text-leaf uppercase">
            Incorporated
          </dt>
          <dd class="mt-2 font-heading text-2xl text-forest">
            {COMPANY.incorporated}
          </dd>
        </div>
        <div class="bg-cream px-6 py-6 sm:px-8">
          <dt class="text-xs font-semibold tracking-[0.16em] text-leaf uppercase">
            Owner
          </dt>
          <dd class="mt-2 font-heading text-2xl text-forest">{COMPANY.owner}</dd>
        </div>
        <div class="bg-cream px-6 py-6 sm:px-8">
          <dt class="text-xs font-semibold tracking-[0.16em] text-leaf uppercase">
            Email
          </dt>
          <dd class="mt-2">
            <a
              href={`mailto:${COMPANY.email}`}
              class="text-lg text-forest underline decoration-citrus/70 underline-offset-4 hover:decoration-citrus"
            >
              {COMPANY.email}
            </a>
          </dd>
        </div>
        <div class="bg-cream px-6 py-6 sm:px-8">
          <dt class="text-xs font-semibold tracking-[0.16em] text-leaf uppercase">
            Phone
          </dt>
          <dd class="mt-2">
            <a
              href={COMPANY.phoneHref}
              class="font-heading text-2xl text-forest"
            >
              {COMPANY.phoneDisplay}
            </a>
          </dd>
        </div>
        <div class="bg-cream px-6 py-6 sm:px-8 sm:col-span-2 lg:col-span-3">
          <dt class="text-xs font-semibold tracking-[0.16em] text-leaf uppercase">
            Registered Office
          </dt>
          <dd class="mt-2 text-lg leading-relaxed text-forest">
            {COMPANY.address.line1}<br />
            {COMPANY.address.locality}<br />
            {COMPANY.address.region}<br />
            {COMPANY.address.postcode}
          </dd>
        </div>
      </dl>

      <div class="border-t border-forest/10 px-6 py-8 sm:px-10">
        <h3 class="text-xs font-semibold tracking-[0.16em] text-leaf uppercase">
          Nature of Business
        </h3>
        <ul class="mt-4 space-y-3">
          {
            COMPANY.sic.map((item) => (
              <li class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:gap-4">
                <span class="font-heading text-xl text-forest">{item.code}</span>
                <span class="text-ink-soft">{item.label}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
