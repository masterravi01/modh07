---
import { Image } from 'astro:assets';
import produceWall from '../assets/images/wholesale.jpg';

const features = [
  {
    title: 'Fresh Produce',
    text: 'A wholesale focus on fruit and vegetable products, with quality as a guiding principle.',
  },
  {
    title: 'Business Supply',
    text: 'Intended for organisations and partners looking to discuss fresh produce supply requirements.',
  },
  {
    title: 'Reliable Service',
    text: 'A practical, professional approach to communication and wholesale conversations.',
  },
] as const;
---

<section
  id="wholesale"
  class="relative overflow-hidden bg-forest py-20 text-cream sm:py-28"
  aria-labelledby="wholesale-heading"
>
  <Image
    src={produceWall}
    alt=""
    widths={[960, 1400, 1920]}
    sizes="100vw"
    class="pointer-events-none absolute inset-0 h-full w-full object-cover opacity-25"
    loading="lazy"
    quality={60}
  />
  <div class="absolute inset-0 bg-forest/80" aria-hidden="true"></div>
  <div class="wrap relative">
    <div class="reveal max-w-3xl">
      <p class="eyebrow text-citrus-soft">Wholesale</p>
      <h2
        id="wholesale-heading"
        class="font-heading text-3xl font-medium tracking-tight text-cream sm:text-4xl lg:text-5xl"
      >
        Wholesale Supply
      </h2>
      <p class="mt-6 max-w-2xl text-base leading-relaxed text-cream/80 sm:text-lg">
        Our wholesale focus is centred on supplying fresh fruit and vegetables
        with a practical, reliable and professional approach.
      </p>
    </div>

    <ul class="mt-12 grid gap-5 md:grid-cols-3">
      {
        features.map((feature, index) => (
          <li class="reveal rounded-2xl border border-cream/10 bg-white/5 p-7">
            <p class="font-heading text-sm text-citrus-soft">
              0{index + 1}
            </p>
            <h3 class="mt-3 font-heading text-2xl text-cream">{feature.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-cream/75">
              {feature.text}
            </p>
          </li>
        ))
      }
    </ul>

    <div class="reveal mt-10">
      <a href="/#contact" class="btn-light">Discuss Wholesale Requirements</a>
    </div>
  </div>
</section>
